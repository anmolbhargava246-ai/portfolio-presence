---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

const idx = projects.findIndex((p) => p.slug === "atlassian");
const project = projects[idx];
const next = projects[(idx + 1) % projects.length];
const base = import.meta.env.BASE_URL; // "/portfolio-presence/full-time/"

const tldr = [
  { k: "Space", v: "Enterprise ITSM, mobile" },
  { k: "Product", v: "Four new on-call scheduling capabilities in Jira Mobile, during the Opsgenie → Jira consolidation" },
  { k: "Method", v: "Moderated task-based usability with role-based scenarios (SEQ and time taken, directional) + workflow interviews" },
  { k: "Sample", v: "12 participants across 5 countries — 6 Engineering Managers, 6 Engineers; Opsgenie users and people on competitor tools; internal pilot first" },
  { k: "Partnered with", v: "Product, Design and Research leadership" },
  { k: "Outcome", v: "Evidence to prioritise Overrides for the mobile roadmap; workflow and role inputs for Design and Research" },
];
---
<Layout
  title="On-call scheduling research — Anmol Bhargava"
  description="Evaluative research on four on-call scheduling capabilities in Jira Mobile, during Atlassian's consolidation of Opsgenie into Jira. The brief asked whether the features worked; the study showed which capabilities mattered on mobile, for whom, and why."
>
  <article class="section section--cream">
    <div class="container" style="max-width: 820px;">
      <a href={`${base}#work`} class="back-link">← Selected work</a>
      <div class="case-meta">Project {project.num} · {project.meta}</div>
      <h1 class="display display--xl" style="color: var(--brick);">{project.title}</h1>
      <p class="lede" style="margin-top: 1rem;">{project.subtitle}</p>
      <div class="case-tags">
        {project.tags.map((t) => <span class="tag">{t}</span>)}
      </div>

      <!-- TL;DR -->
      <div class="tldr">
        <div class="tldr__label">TL;DR</div>
        <div class="tldr__grid">
          {tldr.map((item) => (
            <div>
              <div class="tldr__k">{item.k}</div>
              <div class="tldr__v">{item.v}</div>
            </div>
          ))}
        </div>
        <div class="tldr__shift">
          <div class="tldr__k">Strategic shift</div>
          <div class="tldr__v">
            “Do these four features work?” → “Which capabilities matter on mobile, for whom, and in
            what context?”
          </div>
        </div>
      </div>

      <!-- Problem -->
      <div class="section-label">The problem</div>
      <ul class="checklist">
        <li><span>Atlassian was consolidating Opsgenie capabilities into Jira; on-call scheduling was coming to Jira Mobile</span></li>
        <li><span>On-call scheduling decides who responds to incidents, and when; Overrides let a manager replace an assignment when circumstances change</span></li>
        <li><span>Four newly designed capabilities to evaluate before rollout: daily schedule, monthly schedule, card view, overrides</span></li>
        <li><span>The brief: do these features work, and are they appropriate for mobile?</span></li>
      </ul>

      <!-- The question underneath -->
      <div class="section-label">The question underneath</div>
      <div class="insight">
        <div class="insight__lead">The brief</div>
        <p class="insight__body">
          Do these four features work, and are they appropriate for mobile?
        </p>
      </div>
      <div class="insight">
        <div class="insight__lead">What emerged during the sessions</div>
        <p class="insight__body">
          Feature usability alone wasn’t enough. Which scheduling capabilities actually matter on
          mobile, for whom, and in what context?
        </p>
      </div>
      <div class="insight">
        <div class="insight__lead">The lens that followed</div>
        <p class="insight__body">
          Feature evaluation → workflow understanding → mobile criticality → product prioritisation
        </p>
      </div>

      <!-- How it was run -->
      <div class="section-label">How it was run</div>
      <ul class="checklist">
        <li><span>Three stakeholder needs in one study: Product (migration and mobile prioritisation), Design (do the four features work?), Research (roles, workflows, journey maps, personas)</span></li>
        <li><span>Moderated, task-based usability: role-based scenarios across the four capabilities — completion, interaction problems, hesitation, ease and time taken</span></li>
        <li><span>Workflow interviews in every session: when would this capability actually be valuable in someone’s work?</span></li>
        <li><span>Two roles by design — managers and engineers share the workflow, not the responsibilities</span></li>
        <li><span>12 participants across 5 countries; Opsgenie users and people on competitor tools; internal pilot before the main sessions</span></li>
        <li><span>SEQ and time taken treated as directional — depth and role coverage, not statistical representation</span></li>
      </ul>

      <!-- Findings -->
      <div class="section-label">What we found</div>

      <div class="insight">
        <div class="insight__lead">Role shaped what mattered in the same workflow</div>
        <p class="insight__body">
          Engineers focused on their own schedule, their own responsibilities and alerts. Managers
          needed team-level visibility, team schedules, roster information and the ability to
          manage assignments.
        </p>
      </div>

      <div class="insight">
        <div class="insight__lead">Engineers went to Alerts first</div>
        <p class="insight__body">
          4 of 6 opened Alerts before anything else. The schedule gets checked; alerts are the day.
        </p>
      </div>

      <div class="insight">
        <div class="insight__lead">Overrides solved a time-sensitive mobile job</div>
        <p class="insight__body">
          All six Engineering Managers named Overrides the most important scheduling capability on
          the go: someone becomes unavailable, a shift changes, a different person needs assigning —
          often away from a laptop.
        </p>
        <blockquote class="verbatim">
          <p>
            “I can handle schedule changes without having to get on my laptop. That’s huge when
            something comes up.”
          </p>
          <div class="verbatim__attr">— Engineering Manager</div>
        </blockquote>
      </div>

      <div class="insight">
        <div class="insight__lead">Usability said how; workflow said where and for whom</div>
        <p class="insight__body">
          The task data showed how well each interaction worked. The workflow context showed where
          that interaction actually mattered, and to whom.
        </p>
      </div>

      <!-- The key insight -->
      <div class="kx">
        <div class="kx__kicker">The key insight</div>
        <div class="kx__eq">
          <span class="kx__term">Role + mobile context</span>
          <span class="kx__gt">&gt;</span>
          <span class="kx__term kx__term--dim">feature usability alone</span>
        </div>
        <p class="kx__body">
          Usability testing showed how well each interaction worked. Workflow context showed where,
          and for whom, it actually mattered — which is what Product needed in order to prioritise.
        </p>
        <ul class="kx__ev">
          <li>All six managers: Overrides the most important capability on the go</li>
          <li>4 of 6 engineers opened Alerts first</li>
          <li>Managers wanted the team’s roster; engineers their own schedule</li>
          <li>Schedule changes are time-sensitive and happen away from the laptop</li>
        </ul>
      </div>

      <!-- What changed -->
      <div class="section-label">What changed</div>
      <ul class="checklist">
        <li><span>Product: evidence to prioritise Overrides for the mobile roadmap, and around mobile-critical capabilities more broadly</span></li>
        <li><span>Product: supported thinking on Integrations and Alerts; unlocked follow-up research</span></li>
        <li><span>Design: interaction friction exposed and the scheduling experience refined before broader launch — lower rollout risk</span></li>
        <li><span>Research: real workflow differences added to personas, richer inputs for journey mapping, a stronger research panel</span></li>
        <li><span>The question the team took forward: which capabilities matter on mobile, for whom, and why</span></li>
      </ul>

      <!-- Stakeholders -->
      <div class="section-label">How I worked with the team</div>
      <ul class="checklist">
        <li><span>Three stakeholder needs — Product, Design, Research — balanced in one study rather than three research efforts</span></li>
        <li><span>Insights soft-shared and sparred on before the readout — no big reveal</span></li>
        <li><span>Delivered as verbatims, Loom clips, and how-might-we prompts design could act on</span></li>
        <li><span>Product owned prioritisation; my part was the evidence and the wider lens</span></li>
      </ul>

      <!-- What I'd do differently -->
      <div class="section-label">What I’d do differently today</div>
      <ul class="checklist">
        <li><span>Frame the decision earlier: what are we actually deciding — what matters on mobile, for whom, why, and what evidence would change the prioritisation</span></li>
        <li><span>Use existing evidence first: desktop usage, product analytics, support signals, previous research — find the biggest uncertainty, then research that</span></li>
        <li><span>Run recruitment, pilot, secondary research, guide refinement and stakeholder observation in parallel — reach the decision faster without reducing rigour</span></li>
      </ul>

      <!-- Why it matters -->
      <div class="section-label">Why this matters in enterprise</div>
      <ul class="checklist">
        <li><span>The unit of analysis is the workflow, not the screen — two roles shared one scheduling system and needed different things from it</span></li>
        <li><span>A tactical brief can carry a bigger decision — the job is to notice it during the research and widen the lens without overstepping</span></li>
        <li><span>I don’t need to research everything; I need to find where more evidence would change the decision</span></li>
        <li><span>Research pays off at the decision layer: which capabilities get mobile priority, for whom, and why</span></li>
      </ul>

      <!-- Takeaway -->
      <div class="pullquote">
        <div class="pullquote__label">Takeaway</div>
        <p class="pullquote__text">
          The brief asked whether four features worked. The useful answer was which ones mattered on
          mobile, for whom, and why — and that is the question I’d ask first today.
        </p>
      </div>

      <!-- CTA -->
      <div class="cta-row">
        <a href={`${base}projects/${next.slug}`} class="btn btn--filled-brick">
          Next: {next.title.length > 40 ? next.title.slice(0, 40) + "…" : next.title} →
        </a>
        <a href={`${base}#contact`} class="btn">Get in touch</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .verbatim {
    margin: 1rem 0 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--cream-soft);
    border-left: 3px solid var(--brick);
    border-radius: 0 12px 12px 0;
    max-width: 58ch;
  }
  .verbatim p {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .verbatim__attr {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .kx {
    background: var(--deep);
    color: var(--on-brick);
    border-radius: var(--radius-card);
    padding: 2.5rem 2.25rem;
    margin: 3.5rem 0;
  }
  .kx__kicker {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 1.25rem;
  }
  .kx__eq {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    margin-bottom: 1.25rem;
  }
  .kx__term {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    line-height: 1.1;
  }
  .kx__term--dim {
    opacity: 0.55;
  }
  .kx__gt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    color: var(--peach);
  }
  .kx__body {
    font-size: 0.96rem;
    line-height: 1.6;
    opacity: 0.92;
    max-width: 62ch;
    margin: 0 0 1.5rem;
  }
  .kx__ev {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  @media (min-width: 700px) {
    .kx__ev {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem 1.5rem;
    }
  }
  .kx__ev li {
    font-size: 0.88rem;
    line-height: 1.5;
    padding-left: 1.1rem;
    position: relative;
    opacity: 0.85;
  }
  .kx__ev li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--peach);
    font-weight: 700;
  }
</style>
